@model List<ResultBannerDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Ana Sayfa Banner Alanı</h4>
                    <p class="card-subtitle mb-4">
Ana Sayfanın Banner Alanında Bulunan Bilgileri Aşağıdan Düzenliyebilirsiniz Tema Bütünlüğü Bozulmaması Adına 1 Tane Veri Girişi Yapınız.                    </p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Başlık</th>
                                    <th>Açıklama</th>
                                    <th>VideoUrl</th>
                                    <th>Video Açıklama</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                    <th>Youtubeda Aç</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.Description</td>
                                        <td>@item.VideoUrl</td>
                                        <td>@item.VideoDescription</td>
                                        <td><a href="/Admin/AdminBanner/RemoveBanner/@item.BannerID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Admin/AdminBanner/UpdateBanner/@item.BannerID" class="btn btn-warning">Güncelle</a></td>
                                        <td><a href="/Admin/AdminBanner/UpdateBanner/@item.BannerID" class="btn btn-dark">Youtubeda Aç</a></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                        <td><a href="/Admin/AdminBanner/CreateBanner/" class="btn btn-success">Yeni Banner Girişi</a></td>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




