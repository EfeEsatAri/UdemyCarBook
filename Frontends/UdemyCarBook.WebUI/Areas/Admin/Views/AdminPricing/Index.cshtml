@model List<ResultPricingDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Ödeme Türleri Alanı</h4>
                    <p class="card-subtitle mb-4">
Araçların Günlük, Kiralık, Aylık Veya Benzeri Kiralama Opsiyonlarının Yer Aldığı Sayfadır Bu Sayfa Üzerinden Yeni Bir Zaman Periyodu Eklenebilir Silinebilir Veya Güncellenebilir.                    </p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>periyot Adı</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Name</td>
                                        <td><a href="/Admin/AdminPricing/RemovePricing/@item.PricingID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Admin/AdminPricing/UpdatePricing/@item.PricingID" class="btn btn-warning">Güncelle</a></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                        <td><a href="/Admin/AdminPricing/CreatePricing/" class="btn btn-success">Yeni Ödeme Yöntemi Girişi</a></td>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






