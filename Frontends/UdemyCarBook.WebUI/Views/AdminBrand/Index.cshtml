@model List<ResultBrandDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}




<div class="page-content">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Araba Markaları Listesi</h4>
                    <p class="card-subtitle mb-4">
                        Arabalarla İlgili Marka Listesi, Markalar Üzerinde Düzenleme Ve Bir Markayı Kaldırma İşlemlerini Gerçekleştirebilirsiniz.
                    </p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Marka Adı</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                    <th>Markaya Ait Araçlar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Name</td>
                                        <td><a href="/AdminBrand/RemoveBrand/@item.BrandID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/AdminBrand/UpdateBrand/@item.BrandID" class="btn btn-warning">Güncelle</a></td>
                                        <td><a href="/AdminBrand/UpdateBrand/@item.BrandID" class="btn btn-dark">Markaya Ait Araçlar</a></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                        <td><a href="/AdminBrand/CreateBrand/" class="btn btn-success">Yeni Marka Girişi</a></td>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


