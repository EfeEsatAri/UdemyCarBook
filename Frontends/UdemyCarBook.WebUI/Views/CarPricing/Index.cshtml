@model List<ResultCarPricingListWithModelDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
	int currentPage = ViewBag.CurrentPage ?? 1;
	int totalPages = ViewBag.TotalPages ?? 1;
}

<section class="ftco-section ftco-cart">
	<div class="container">
		<div class="row">
			<div class="col-md-12 ftco-animate">
				<div class="car-list">
					<table class="table">
						<thead class="thead-primary">
							<tr class="text-center">
								<th>&nbsp;</th>
								<th>&nbsp;</th>
								<th class="bg-primary heading">Günlük Kiralama Ücreti</th>
								<th class="bg-dark heading">Haftalık Kiralama Ücreti</th>
								<th class="bg-black heading">Aylık Kiralama Ücreti</th>
							</tr>
						</thead>
						@foreach(var item in Model)
						{
							<tbody>
								<tr class="">
									<td class="car-image"><div class="img" style="background-image:url(@item.CoverImageUrl);"></div></td>
									<td class="product-name">
										<h3>@item.model @item.BrandName</h3>
										<p class="mb-0 rated">
											<span>Puanı:</span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
										</p>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Bu Aracı Kiralayın</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small> @item.dailyAmount</span>
												<span class="per">/Günlük Fiyat</span>
											</h3>
										</div>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Bu Aracı Kiralayın</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small>@item.weeklyAmount</span>
												<span class="per">/Haftalık Fiyat</span>
											</h3>
										</div>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Bu Aracı Kiralayın</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small>@item.monthlyAmount</span>
												<span class="per">/Aylık Fiyat</span>
											</h3>
										</div>
									</td>
								</tr>
							</tbody>
						}
						@if (totalPages > 1)
						{
							<div class="row mt-4">
								<div class="col text-center">
									<div class="block-27">
										<ul>
											<li class="@(currentPage <= 1 ? "disabled" : "")">
												<a href="@(currentPage > 1 ? Url.Action("Index", "CarPricing", new { page = currentPage - 1 }) : "#")">&lt;</a>
											</li>

											@for (int i = 1; i <= totalPages; i++)
											{
												<li class="@(i == currentPage ? "active" : "")">
													<a href="@Url.Action("Index", "CarPricing", new { page = i })">@i</a>
												</li>
											}

											<li class="@(currentPage >= totalPages ? "disabled" : "")">
												<a href="@(currentPage<totalPages? Url.Action("Index", "CarPricing", new { page = currentPage + 1 }) : "#")">&gt;</a>
											</li>
										</ul>
									</div>
								</div>
							</div>
						}
					</table>
				</div>
			</div>
		</div>
	</div>
</section>

